<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Filter Pill Button -->
    <Style x:Key="FilterPillStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{StaticResource VkCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource VkCardBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VkTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource FilterPillStyle}" />

    <!-- Video Card Button -->
    <Style x:Key="VideoCardButtonStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Sidebar Item -->
    <Style x:Key="SidebarItemStyle" TargetType="NavigationViewItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="4,2" />
    </Style>

    <!-- Download Card -->
    <Style x:Key="DownloadCardStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource VkCardBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Section Header -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Style" Value="{StaticResource SubtitleTextBlockStyle}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{StaticResource VkTextPrimaryBrush}" />
    </Style>

    <!-- Accent Button -->
    <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Text Link Button -->
    <Style x:Key="TextLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{StaticResource VkTextSecondaryBrush}" />
    </Style>

    <!-- VK Themed Page -->
    <Style x:Key="VkPageStyle" TargetType="Page">
        <Setter Property="Background" Value="{StaticResource VkBackgroundBrush}" />
    </Style>

</ResourceDictionary>
