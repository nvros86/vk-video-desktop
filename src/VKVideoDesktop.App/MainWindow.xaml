<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VKVideoDesktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VK Video Desktop"
    MinWidth="1280"
    MinHeight="720"
    Width="1400"
    Height="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Padding="12,8" Height="48"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="VK Video Desktop"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="0,0,24,0" />

            <AutoSuggestBox Grid.Column="1" x:Name="SearchBox"
                            PlaceholderText="Поиск видео, каналов и авторов..."
                            QueryIcon="Find" Width="500" MaxWidth="600"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            KeyDown="OnSearchBoxKeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <Button ToolTipService.ToolTip="Загрузки" Click="OnDownloadsClick">
                    <FontIcon Glyph="&#xE896;" />
                </Button>
                <Button ToolTipService.ToolTip="Настройки" Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <NavigationView x:Name="NavView" Grid.Column="0" Width="240"
                            PaneDisplayMode="Left" IsSettingsVisible="False"
                            IsBackButtonVisible="Collapsed"
                            IsTitleBarAutoPaddingEnabled="False"
                            SelectionChanged="OnNavSelectionChanged"
                            Loaded="OnNavViewLoaded">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Главная" Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Поиск" Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Избранное" Tag="Favorites">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Плейлисты" Tag="Playlists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="История" Tag="History">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Загрузки" Tag="Downloads">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Frame x:Name="ContentFrame" />
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
