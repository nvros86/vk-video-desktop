<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VKVideoDesktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VK Video Desktop"
    MinWidth="1280"
    MinHeight="720"
    Width="1400"
    Height="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Padding="12,8" Height="48"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="VK Video Desktop"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="0,0,24,0" />

            <AutoSuggestBox Grid.Column="1" x:Name="SearchBox"
                            PlaceholderText="Поиск видео, каналов и авторов..."
                            QueryIcon="Find" Width="500" MaxWidth="600"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            KeyDown="OnSearchBoxKeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <Button ToolTipService.ToolTip="Загрузки" Click="OnDownloadsClick">
                    <FontIcon Glyph="&#xE896;" />
                </Button>
                <Button ToolTipService.ToolTip="Настройки" Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <NavigationView x:Name="NavView" Grid.Column="0" Width="240"
                            PaneDisplayMode="Left" IsSettingsVisible="False"
                            IsBackButtonVisible="Collapsed"
                            IsTitleBarAutoPaddingEnabled="False"
                            SelectionChanged="OnNavSelectionChanged"
                            Loaded="OnNavViewLoaded">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Главная" Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Поиск" Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Избранное" Tag="Favorites">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Плейлисты" Tag="Playlists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="История" Tag="History">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Загрузки" Tag="Downloads">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="OfflineBanner" Grid.Row="0" Background="#FFFFC107" Padding="12,6"
                                HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock Text="Нет подключения. Скачанные видео доступны офлайн." FontSize="12" />
                    </StackPanel>

                    <Frame x:Name="ContentFrame" Grid.Row="1" />
                </Grid>
            </NavigationView>
        </Grid>

        <!-- Mini Player Bar -->
        <Grid x:Name="MiniPlayerBar" Grid.Row="2" Height="48" Padding="12,0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="MiniPlayerTitle" Grid.Column="0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" FontSize="13" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Click="OnMiniPlayerPlayClick" ToolTipService.ToolTip="Воспроизвести/Пауза">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                </Button>
                <Button Click="OnMiniPlayerPrevClick" ToolTipService.ToolTip="Предыдущее">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button Click="OnMiniPlayerNextClick" ToolTipService.ToolTip="Следующее">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button Click="OnMiniPlayerFullscreenClick" ToolTipService.ToolTip="Полный экран">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </Button>
                <Button Click="OnMiniPlayerCloseClick" ToolTipService.ToolTip="Закрыть">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <Grid x:Name="ErrorBanner" Grid.Row="1" HorizontalAlignment="Stretch"
              VerticalAlignment="Top" Padding="12,8"
              Background="#FFE53935" Foreground="White"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorBannerText" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="13" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    Background="Transparent" Foreground="White"
                    Click="OnCloseErrorBanner" />
        </Grid>

        <!-- Downloads Panel -->
        <Grid x:Name="DownloadsPanel" Grid.Row="1" Grid.ColumnSpan="2"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="360" Height="400" Margin="0,0,12,12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,8">
                <TextBlock Text="Загрузки" Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                        HorizontalAlignment="Right" Click="OnCloseDownloadsPanel"
                        Style="{StaticResource TextButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
