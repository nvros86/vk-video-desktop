<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VKVideoDesktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App"
    Title="VK Video Desktop"
    MinWidth="1280"
    MinHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Padding="12,8" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="VK Video Desktop"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="0,0,24,0" />

            <AutoSuggestBox Grid.Column="1" PlaceholderText="Поиск видео, каналов и авторов..."
                            QueryIcon="Find" Width="500" MaxWidth="600"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <Button Content="⬇" ToolTipService.ToolTip="Загрузки" />
                <Button Content="⚙" ToolTipService.ToolTip="Настройки" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <NavigationView Grid.Column="0" Width="220"
                            PaneDisplayMode="Left" IsSettingsVisible="True">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Главная" Icon="Home" />
                    <NavigationViewItem Content="Поиск" Icon="Find" />
                    <NavigationViewItem Content="Мои видео" Icon="Video" />
                    <NavigationViewItem Content="Подписки" Icon="Contact" />
                    <NavigationViewItem Content="Избранное" Icon="Like" />
                    <NavigationViewItem Content="Плейлисты" Icon="Music" />
                    <NavigationViewItem Content="История" Icon="Clock" />
                    <NavigationViewItem Content="Загрузки" Icon="Download" />
                </NavigationView.MenuItems>
            </NavigationView>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="16">
                <TextBlock Text="Выберите раздел"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.5" />
            </Grid>

            <!-- Downloads Panel -->
            <Grid Grid.Column="2" Width="300" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Visibility="Collapsed">
                <TextBlock Text="Загрузки" Margin="16,12"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
            </Grid>
        </Grid>

        <!-- Mini Player Bar -->
        <Grid Grid.Row="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Height="80" Padding="12,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Width="100" Height="60" Margin="0,0,12,0"
                   CornerRadius="4" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Название видео" FontWeight="SemiBold" />
                <TextBlock Text="Автор" Opacity="0.6" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Content="◀◀" />
                <Button Content="▶" />
                <Button Content="▶▶" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
