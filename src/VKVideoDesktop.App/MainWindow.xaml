<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VKVideoDesktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:VKVideoDesktop.App.Views"
    Title="VK Video Desktop"
    MinWidth="1280"
    MinHeight="720"
    Width="1400"
    Height="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Padding="12,8" Height="48"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="VK Video Desktop"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" Margin="0,0,24,0" />

            <AutoSuggestBox Grid.Column="1" x:Name="SearchBox"
                            PlaceholderText="Поиск видео, каналов и авторов..."
                            QueryIcon="Find" Width="500" MaxWidth="600"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            KeyDown="OnSearchBoxKeyDown" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <Button ToolTipService.ToolTip="Загрузки (Ctrl+J)" Click="OnDownloadsClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE896;" />
                        <TextBlock x:Name="DownloadCountBadge" Text="0" FontSize="10"
                                   VerticalAlignment="Top" Background="{ThemeResource AccentColor}"
                                   Foreground="White" Padding="3,1" CornerRadius="6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Button ToolTipService.ToolTip="Настройки" Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <NavigationView x:Name="NavView" Grid.Column="0" Width="240"
                            PaneDisplayMode="Left" IsSettingsVisible="False"
                            IsBackButtonVisible="Collapsed"
                            IsTitleBarAutoPaddingEnabled="False"
                            SelectionChanged="OnNavSelectionChanged"
                            Loaded="OnNavViewLoaded">

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Главная" Tag="Home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Поиск" Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Мои видео" Tag="MyVideos">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE714;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Подписки" Tag="Subscriptions">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="."&gt;77;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Избранное" Tag="Favorites">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Плейлисты" Tag="Playlists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="История" Tag="History">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Загрузки" Tag="Downloads">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.MenuItemTemplate>
                    <DataTemplate>
                        <NavigationViewItem Content="{Binding Content}" Tag="{Binding Tag}"
                                           Icon="{Binding Icon}" />
                    </DataTemplate>
                </NavigationView.MenuItemTemplate>

                <Grid>
                    <Frame x:Name="ContentFrame" />
                </Grid>
            </NavigationView>

            <!-- Downloads Side Panel -->
            <Grid x:Name="DownloadsPanel" Grid.Column="1" Width="340"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,12">
                    <TextBlock Text="Загрузки" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button Content="✕" HorizontalAlignment="Right"
                            Click="OnCloseDownloadsPanel" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind DownloadItems}"
                          Padding="8,0,8,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <Grid Margin="0,0,0,8" Padding="8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="80" Height="45" CornerRadius="4"
                                      Margin="0,0,8,0">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                </Grid>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Text="{x:Bind StatusText}" Opacity="0.6" FontSize="11" />
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="100"
                                                 Height="2" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Mini Player Bar -->
        <Grid x:Name="MiniPlayerBar" Grid.Row="2" Height="72"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0" Padding="12,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="100" Height="56" CornerRadius="4" Margin="0,0,12,0">
                <Image Source="{x:Bind MiniPlayerThumbnail}" Stretch="UniformToFill" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="MiniPlayerTitle" Text="Название видео"
                           FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="MiniPlayerAuthor" Text="Автор" Opacity="0.6" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <Button Content="&#xE892;" Click="OnMiniPlayerPrevClick"
                        ToolTipService.ToolTip="Предыдущее" />
                <Button x:Name="MiniPlayerPlayBtn" Content="&#xE768;"
                        Click="OnMiniPlayerPlayClick" ToolTipService.ToolTip="Play/Pause" />
                <Button Content="&#xE893;" Click="OnMiniPlayerNextClick"
                        ToolTipService.ToolTip="Следующее" />
                <Button Content="&#xE740;" Click="OnMiniPlayerFullscreenClick"
                        ToolTipService.ToolTip="Полный экран (F)" />
                <Button Content="&#xE73E;" Click="OnMiniPlayerCloseClick"
                        ToolTipService.ToolTip="Закрыть" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
