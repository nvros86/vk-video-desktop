<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Input -->
        <AutoSuggestBox Grid.Row="0" x:Name="SearchBox"
                        PlaceholderText="Поиск видео, каналов и авторов..."
                        QueryIcon="Find" Margin="24,16" Width="600"
                        HorizontalAlignment="Center"
                        TextChanged="OnSearchTextChanged"
                        QuerySubmitted="OnSearchSubmitted" />

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="24,0,0,16">
            <RadioButton Content="Все" IsChecked="True" Tag="All"
                         Checked="OnFilterChanged" Style="{StaticResource FilterPillStyle}" />
            <RadioButton Content="Видео" Tag="Videos"
                         Checked="OnFilterChanged" Style="{StaticResource FilterPillStyle}" />
            <RadioButton Content="Каналы" Tag="Channels"
                         Checked="OnFilterChanged" Style="{StaticResource FilterPillStyle}" />
            <RadioButton Content="Авторы" Tag="Authors"
                         Checked="OnFilterChanged" Style="{StaticResource FilterPillStyle}" />
            <ComboBox x:Name="SortComboBox" MinWidth="160" Margin="16,0,0,0"
                      SelectedIndex="0" SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="По релевантности" Tag="Relevance" />
                <ComboBoxItem Content="По дате" Tag="Date" />
                <ComboBoxItem Content="По просмотрам" Tag="Views" />
                <ComboBoxItem Content="По длительности" Tag="Duration" />
            </ComboBox>
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,80">
                <!-- Loading -->
                <ProgressRing x:Name="LoadingRing" IsActive="False"
                              HorizontalAlignment="Center" Margin="0,40,0,0" />

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Spacing="12">
                    <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{StaticResource VkTextTertiaryBrush}" />
                    <TextBlock Text="Введите запрос для поиска"
                               Foreground="{StaticResource VkTextSecondaryBrush}"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Results Grid -->
                <ItemsControl x:Name="ResultsList" Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VideoViewModel">
                            <Button HorizontalAlignment="Left" Margin="0,0,12,12"
                                    Click="OnVideoClick" Tag="{x:Bind Id}">
                                <Grid Width="280">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Height="158" CornerRadius="4,4,0,0">
                                        <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                        <TextBlock Text="{x:Bind DurationText}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom" Background="{StaticResource VkOverlayBrush}"
                                                   Foreground="{StaticResource VkTextPrimaryBrush}" FontSize="11" Padding="4,2"
                                                   Margin="0,0,4,4" CornerRadius="2" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   Foreground="{StaticResource VkTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Author}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontSize="12"
                                                   Foreground="{StaticResource VkTextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewCountText}" FontSize="11"
                                                   Foreground="{StaticResource VkTextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="LoadMoreButton" Content="Загрузить ещё" Click="OnLoadMoreClick"
                        HorizontalAlignment="Center" Margin="0,16" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
