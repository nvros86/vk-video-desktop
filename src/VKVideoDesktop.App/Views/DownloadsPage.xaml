<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Загрузки" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource VkTextPrimaryBrush}" VerticalAlignment="Center" />
                <Border Background="{StaticResource VkAccentBrush}" CornerRadius="10"
                        Padding="8,3" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasActiveDownloads, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.ActiveDownloadsCount}" FontSize="12" FontWeight="Bold"
                               Foreground="White" />
                </Border>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Добавить загрузку" Padding="12,6"
                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6"
                    Click="OnAddDownloadClick" />
        </Grid>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="24,0">
            <RadioButton Content="Активные" IsChecked="True" Style="{StaticResource FilterPillStyle}" />
            <RadioButton Content="Завершенные" Style="{StaticResource FilterPillStyle}" />
            <RadioButton Content="Все" Style="{StaticResource FilterPillStyle}" />
        </StackPanel>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40">
            <FontIcon Glyph="&#xE896;" FontSize="64" Opacity="0.3" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="Нет загрузок" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <TextBlock Text="Скачивайте видео для просмотра офлайн" Opacity="0.6" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextSecondaryBrush}" />
        </StackPanel>

        <!-- Downloads List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,80">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Downloads}" Margin="24,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                        <Grid Style="{StaticResource DownloadCardStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Border Grid.Column="0" Width="120" Height="68" CornerRadius="6"
                                    Margin="0,0,12,0">
                                <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind StatusText}" FontSize="12"
                                           Foreground="{StaticResource VkTextSecondaryBrush}" />
                                <ProgressBar Value="{x:Bind Progress}" Maximum="100"
                                             Style="{StaticResource DownloadProgressStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ProgressText}" FontSize="11"
                                               Foreground="{StaticResource VkTextTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind SpeedText}" FontSize="11"
                                               Foreground="{StaticResource VkTextTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind EtaText}" FontSize="11"
                                               Foreground="{StaticResource VkTextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button ToolTipService.ToolTip="Пауза" Background="Transparent"
                                        BorderThickness="0" Padding="8" Click="OnPauseClick"
                                        Tag="{x:Bind DownloadId}" Visibility="{x:Bind IsDownloading}">
                                    <FontIcon Glyph="&#xE769;" FontSize="14"
                                              Foreground="{StaticResource VkTextSecondaryBrush}" />
                                </Button>
                                <Button ToolTipService.ToolTip="Отмена" Background="Transparent"
                                        BorderThickness="0" Padding="8" Click="OnCancelClick"
                                        Tag="{x:Bind DownloadId}">
                                    <FontIcon Glyph="&#xE711;" FontSize="14"
                                              Foreground="{StaticResource VkErrorBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
