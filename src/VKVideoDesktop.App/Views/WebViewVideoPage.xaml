<Page
    x:Class="VKVideoDesktop.App.Views.WebViewVideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets" Style="{ThemeResource SubtleButtonStyle}"
                    Click="OnBackClick" />

            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                       Margin="12,0" FontSize="14" FontWeight="SemiBold" />

            <Button x:Name="OpenInBrowserButton" Grid.Column="2" Content="&#xE774;"
                    FontFamily="Segoe MDL2 Assets" Style="{ThemeResource SubtleButtonStyle}"
                    Click="OnOpenInBrowser" />
        </Grid>

        <WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</Page>
