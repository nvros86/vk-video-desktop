<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="24,16">
                <!-- Video Player -->
                <Grid x:Name="PlayerContainer" Height="480" Background="#1E1E1E" CornerRadius="8,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thumbnail / Player overlay -->
                    <Grid Grid.Row="0">
                        <Image x:Name="ThumbnailImage"
                               Source="{Binding CurrentVideo.ThumbnailUrl}"
                               Stretch="UniformToFill" Opacity="0.5" />
                        <MediaPlayerElement x:Name="MediaPlayerElement"
                                           AutoPlay="True"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           Visibility="Collapsed" />
                        <Button x:Name="PlayButton"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#CC000000" Foreground="White"
                                Width="72" Height="72" CornerRadius="36"
                                Click="OnPlayClick">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="32" />
                        </Button>
                    </Grid>

                    <!-- Controls -->
                    <Grid Grid.Row="1" Background="#CC000000" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="ControlPlayButton" Content="&#xE768;" Background="Transparent"
                                Foreground="White" Click="OnPlayClick" />
                        <ProgressBar Grid.Column="1" x:Name="PositionBar" Value="0" Maximum="100"
                                     Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="TimeText" Text="0:00 / 0:00" Foreground="White"
                                   VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" />

                        <!-- Speed selector -->
                        <Button Grid.Column="3" x:Name="SpeedButton" Content="1x" Background="Transparent"
                                Foreground="White" Click="OnSpeedClick" FontSize="11" Padding="6,2"
                                ToolTipService.ToolTip="Скорость воспроизведения" />

                        <!-- Quality selector -->
                        <Button Grid.Column="4" x:Name="QualityButton" Content="HQ" Background="Transparent"
                                Foreground="White" Click="OnQualityClick" FontSize="11" Padding="6,2"
                                ToolTipService.ToolTip="Качество видео" />

                        <!-- PiP -->
                        <Button Grid.Column="5" Content="&#xE740;" Background="Transparent"
                                Foreground="White" Click="OnPipClick"
                                ToolTipService.ToolTip="Картинка в картинке" />

                        <Button Grid.Column="6" x:Name="VolumeButton" Content="&#xE767;" Background="Transparent"
                                Foreground="White" Click="OnVolumeClick" />
                        <Button Grid.Column="7" Content="&#xE740;" Background="Transparent"
                                Foreground="White" Click="OnFullscreenClick" />
                    </Grid>
                </Grid>

                <!-- Video Info -->
                <TextBlock Text="{Binding CurrentVideo.Title}"
                           Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"
                           Margin="0,16,0,8" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CurrentVideo.ChannelAvatarUrl}"
                                        Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentVideo.Author}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentVideo.ViewCountText}"
                                   Opacity="0.6" FontSize="12" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Подписаться"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                    <Button Content="❤️ Избранное" Click="OnFavoriteClick" />
                    <Button Content="➕ Плейлист" />
                    <Button Content="⬇ Скачать" Click="OnDownloadClick" />
                    <Button Content="↗ Поделиться" />
                    <Button Content="🌐 WebView2" Click="OnWebViewFallbackClick"
                            ToolTipService.ToolTip="Открыть в WebView2" />
                </StackPanel>

                <!-- Description -->
                <Expander Header="Описание">
                    <TextBlock Text="{Binding CurrentVideo.Description}"
                               TextWrapping="Wrap" Opacity="0.8" />
                </Expander>
            </StackPanel>

            <!-- Right Panel: Related Videos -->
            <StackPanel Grid.Column="1" Margin="0,16,24,0">
                <TextBlock Text="Похожие видео" Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.RelatedVideos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VideoDisplayViewModel">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Click="OnRelatedVideoClick" Tag="{x:Bind Id}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="160" Height="90" CornerRadius="4"
                                          Margin="0,0,12,0">
                                        <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                        <TextBlock Text="{x:Bind DurationText}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom" Background="#CC000000"
                                                   Foreground="White" FontSize="10" Padding="3,1"
                                                   Margin="0,0,3,3" CornerRadius="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="{x:Bind Author}" Opacity="0.6" FontSize="11" />
                                        <TextBlock Text="{x:Bind ViewCountText}" Opacity="0.5" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
