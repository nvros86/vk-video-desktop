<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="24,16">
                <!-- Video Player -->
                <Grid x:Name="PlayerContainer" Height="480" Background="{StaticResource VkPlayerBackgroundBrush}" CornerRadius="8,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thumbnail / Player overlay -->
                    <Grid Grid.Row="0">
                        <Image x:Name="ThumbnailImage"
                               Source="{Binding CurrentVideo.ThumbnailUrl}"
                               Stretch="UniformToFill" Opacity="0.5" />
                        <MediaPlayerElement x:Name="MediaPlayerElement"
                                           AutoPlay="True"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           Visibility="Collapsed" />
                        <Button x:Name="PlayButton"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource VkOverlayBrush}" Foreground="{StaticResource VkTextPrimaryBrush}"
                                Width="72" Height="72" CornerRadius="36"
                                Click="OnPlayClick">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="32" />
                        </Button>
                    </Grid>

                    <!-- Controls -->
                    <Grid Grid.Row="1" Background="{StaticResource VkPlayerControlsBrush}" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="ControlPlayButton" Content="&#xE768;" Background="Transparent"
                                Foreground="{StaticResource VkTextPrimaryBrush}" Click="OnPlayClick" />
                        <ProgressBar Grid.Column="1" x:Name="PositionBar" Value="0" Maximum="100"
                                     Margin="12,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource VkProgressBrush}"
                                     Background="{StaticResource VkProgressTrackBrush}" />
                        <TextBlock Grid.Column="2" x:Name="TimeText" Text="0:00 / 0:00"
                                   Foreground="{StaticResource VkTextPrimaryBrush}"
                                   VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0" />

                        <!-- Speed selector -->
                        <Button Grid.Column="3" x:Name="SpeedButton" Content="1x" Background="Transparent"
                                Foreground="{StaticResource VkTextPrimaryBrush}" Click="OnSpeedClick" FontSize="11" Padding="6,2"
                                x:Uid="VideoSpeedTooltip" />

                        <!-- Quality selector -->
                        <Button Grid.Column="4" x:Name="QualityButton" Content="HQ" Background="Transparent"
                                Foreground="{StaticResource VkTextPrimaryBrush}" Click="OnQualityClick" FontSize="11" Padding="6,2"
                                x:Uid="VideoQualityTooltip" />

                        <!-- PiP -->
                        <Button Grid.Column="5" Content="&#xE740;" Background="Transparent"
                                Foreground="{StaticResource VkTextPrimaryBrush}" Click="OnPipClick"
                                x:Uid="VideoPiPTooltip" />

                        <Button Grid.Column="6" x:Name="VolumeButton" Content="&#xE767;" Background="Transparent"
                                Foreground="{StaticResource VkTextPrimaryBrush}" Click="OnVolumeClick" />
                        <Button Grid.Column="7" Content="&#xE740;" Background="Transparent"
                                Foreground="{StaticResource VkTextPrimaryBrush}" Click="OnFullscreenClick" />
                    </Grid>
                </Grid>

                <!-- Video Info -->
                <TextBlock Text="{Binding CurrentVideo.Title}"
                           Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{StaticResource VkTextPrimaryBrush}"
                           Margin="0,16,0,8" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CurrentVideo.ChannelAvatarUrl}"
                                        Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentVideo.Author}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource VkTextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentVideo.ViewCountText}"
                                   FontSize="12"
                                   Foreground="{StaticResource VkTextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Подписаться" CornerRadius="20" Padding="20,10"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                    <Button Content="Избранное" Click="OnFavoriteClick"
                            Background="{StaticResource VkCardBrush}" Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16,8" />
                    <Button Content="Плейлист"
                            Background="{StaticResource VkCardBrush}" Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16,8" />
                    <Button Content="Скачать" Click="OnDownloadClick"
                            Background="{StaticResource VkCardBrush}" Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16,8" />
                    <Button Content="Поделиться"
                            Background="{StaticResource VkCardBrush}" Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16,8" />
                    <Button Content="Открыть в WebView" Click="OnWebViewFallbackClick"
                            Background="{StaticResource VkCardBrush}" Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16,8" />
                </StackPanel>

                <!-- Description -->
                <Expander Header="Описание" Margin="0,0,0,16">
                    <TextBlock Text="{Binding CurrentVideo.Description}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource VkTextSecondaryBrush}" />
                </Expander>

                <!-- Comments Section -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Комментарии" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" Margin="0,0,0,12" />
                    <Grid Background="{StaticResource VkCardBrush}" CornerRadius="8" Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0"
                                 Fill="{StaticResource VkCardHoverBrush}" />
                        <TextBox Grid.Column="1" PlaceholderText="Написать комментарий..."
                                 Background="Transparent"
                                 Foreground="{StaticResource VkTextPrimaryBrush}"
                                 BorderThickness="0" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Right Panel: Related Videos -->
            <StackPanel Grid.Column="1" Margin="0,16,24,0">
                <TextBlock Text="Похожие видео" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource VkTextPrimaryBrush}"
                           Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.RelatedVideos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VideoDisplayViewModel">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Click="OnRelatedVideoClick" Tag="{x:Bind Id}" Margin="0,0,0,8"
                                    Background="Transparent" BorderThickness="0" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="160" Height="90" CornerRadius="6"
                                          Margin="0,0,12,0">
                                        <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{StaticResource VkOverlayBrush}" CornerRadius="4"
                                                Margin="0,0,4,4" Padding="4,2">
                                            <TextBlock Text="{x:Bind DurationText}"
                                                       Foreground="White" FontSize="10" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource VkTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Author}" FontSize="11"
                                                   Foreground="{StaticResource VkTextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewCountText}" FontSize="11"
                                                   Foreground="{StaticResource VkTextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
