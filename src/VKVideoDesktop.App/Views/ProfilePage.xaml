<Page
    x:Class="VKVideoDesktop.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid>
        <!-- Loading State -->
        <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="16">
            <ProgressRing IsActive="True" Width="40" Height="40"
                          Foreground="{StaticResource VkAccentBrush}" />
            <TextBlock Text="Загрузка профиля..." FontSize="14"
                       Foreground="{StaticResource VkTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer x:Name="MainContent" VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="0">

                <!-- Profile Header / Banner -->
                <Grid Height="200">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0F2847" Offset="0"/>
                            <GradientStop Color="#FF1A3D6E" Offset="0.5"/>
                            <GradientStop Color="#FF0A1E3D" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Decorative circles -->
                    <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Opacity="0.05" Fill="{StaticResource VkAccentBrush}" Margin="0,0,-80,-80" />
                    <Ellipse Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Opacity="0.03" Fill="{StaticResource VkAccentBrush}" Margin="-60,-60,0,0" />

                    <!-- Avatar + Info -->
                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Bottom"
                                Margin="32,0,32,24">
                        <Grid Width="100" Height="100">
                            <Ellipse Stroke="{StaticResource VkAccentBrush}" StrokeThickness="3"
                                     Fill="{StaticResource VkCardBrush}" />
                            <Ellipse x:Name="AvatarEllipse">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Fallback icon when no avatar -->
                            <FontIcon x:Name="AvatarFallback" Glyph="&#xE77B;" FontSize="40"
                                      Foreground="{StaticResource VkTextTertiaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="UserNameText" Text="Загрузка..."
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock x:Name="UserDomainText" Text=""
                                       FontSize="14" Foreground="{StaticResource VkTextSecondaryBrush}" />
                            <TextBlock x:Name="UserStatusText" Text=""
                                       FontSize="12" Foreground="{StaticResource VkTextTertiaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="400" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Stats Row (only for authenticated users) -->
                <Grid x:Name="StatsRow" Padding="32,20" Background="{StaticResource VkSurfaceBrush}"
                      BorderBrush="{StaticResource VkTopBarBorderBrush}" BorderThickness="0,0,0,1"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="SubscribersCount" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource VkTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Uid="ProfileSubscribers" FontSize="12"
                                   Foreground="{StaticResource VkTextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Height="36"
                               Fill="{StaticResource VkSeparatorBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="VideosCount" Text="—" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource VkTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Uid="ProfileVideos" FontSize="12"
                                   Foreground="{StaticResource VkTextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Rectangle Grid.Column="3" Width="1" Height="36"
                               Fill="{StaticResource VkSeparatorBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="FavoritesCount" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource VkTextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Uid="ProfileFavorites" FontSize="12"
                                   Foreground="{StaticResource VkTextSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Guest Login Prompt -->
                <StackPanel x:Name="GuestPrompt" Visibility="Collapsed"
                            HorizontalAlignment="Center" Spacing="12" Padding="32,40">
                    <FontIcon Glyph="&#xE77B;" FontSize="48" Opacity="0.3"
                              Foreground="{StaticResource VkTextTertiaryBrush}" />
                    <TextBlock Text="Войдите в аккаунт" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource VkTextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Чтобы видеть свои видео, избранное и плейлисты"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource VkTextSecondaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="350" />
                    <Button x:Uid="LoginButton" HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" Click="OnGuestLoginClick"
                            Padding="32,12" CornerRadius="20" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Quick Actions (only for authenticated users) -->
                <StackPanel x:Name="QuickActions" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Padding="32,20" Visibility="Collapsed">
                    <Button x:Uid="ProfileMyVideos" Tag="MyVideos" Click="OnQuickActionClick"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="20" Padding="20,10"
                            FontSize="13" />
                    <Button x:Uid="ProfileFavorites" Tag="Favorites" Click="OnQuickActionClick"
                            Background="{StaticResource VkCardBrush}"
                            Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="20,10" FontSize="13" />
                    <Button x:Uid="ProfilePlaylists" Tag="Playlists" Click="OnQuickActionClick"
                            Background="{StaticResource VkCardBrush}"
                            Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="20,10" FontSize="13" />
                    <Button x:Uid="ProfileHistory" Tag="History" Click="OnQuickActionClick"
                            Background="{StaticResource VkCardBrush}"
                            Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="20,10" FontSize="13" />
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel Padding="32,0" Spacing="4">
                    <TextBlock x:Uid="ProfileMenuTitle" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource VkTextTertiaryBrush}" Margin="0,0,0,8" />

                    <Button Tag="Favorites" Click="OnMenuItemClick" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE734;" Foreground="{StaticResource VkAccentBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="ProfileFavorites" FontSize="14"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="Видео, которые вам понравились" FontSize="11"
                                           Foreground="{StaticResource VkTextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Tag="Playlists" Click="OnMenuItemClick" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE8B4;" Foreground="{StaticResource VkPlaylistBlueBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="ProfilePlaylists" FontSize="14"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="Ваши плейлисты" FontSize="11"
                                           Foreground="{StaticResource VkTextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Tag="History" Click="OnMenuItemClick" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE81C;" Foreground="{StaticResource VkPlaylistGreenBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="ProfileHistory" FontSize="14"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="Недавно просмотренные видео" FontSize="11"
                                           Foreground="{StaticResource VkTextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Tag="Settings" Click="OnMenuItemClick" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="&#xE713;" Foreground="{StaticResource VkTextSecondaryBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="ProfileSettings" FontSize="14"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="Язык, тема, загрузки" FontSize="11"
                                           Foreground="{StaticResource VkTextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Height="1" Fill="{StaticResource VkSeparatorBrush}" Margin="32,16" />

                <!-- Logout -->
                <StackPanel Padding="32,0,32,32">
                    <Button x:Uid="ProfileLogout" Click="OnLogoutClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="Transparent"
                            Foreground="{StaticResource VkErrorBrush}"
                            BorderBrush="{StaticResource VkErrorBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,10" FontSize="13" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
