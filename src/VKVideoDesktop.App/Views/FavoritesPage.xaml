<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="FavoritesTitle" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource VkTextPrimaryBrush}" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="Сортировать" Padding="12,6"
                    Background="{StaticResource VkCardBrush}"
                    Foreground="{StaticResource VkTextSecondaryBrush}"
                    BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" />
        </Grid>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="24,0">
            <RadioButton x:Uid="FavoritesTabAll" IsChecked="True" Style="{StaticResource FilterPillStyle}" />
            <RadioButton x:Uid="FavoritesTabVideos" Style="{StaticResource FilterPillStyle}" />
            <RadioButton x:Uid="FavoritesTabChannels" Style="{StaticResource FilterPillStyle}" />
            <RadioButton x:Uid="FavoritesTabPlaylists" Style="{StaticResource FilterPillStyle}" />
        </StackPanel>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40">
            <FontIcon Glyph="&#xE734;" FontSize="64" Opacity="0.3" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="Избранное пусто" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <TextBlock Text="Добавляйте видео в избранное для быстрого доступа" Opacity="0.6" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextSecondaryBrush}" />
        </StackPanel>

        <!-- Favorites Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,80">
            <ItemsControl x:Name="FavoritesItemsControl" Margin="24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VideoViewModel">
                        <Button HorizontalAlignment="Left" Margin="0,0,12,12"
                                Click="OnVideoItemClick" Tag="{x:Bind Id}"
                                Background="Transparent" BorderThickness="0" Padding="0">
                            <Grid Width="280">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Height="158" CornerRadius="8">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                    <Border Background="{StaticResource VkOverlayBrush}" CornerRadius="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,6,6" Padding="6,2">
                                        <TextBlock Text="{x:Bind DurationText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Author}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" FontSize="12"
                                               Foreground="{StaticResource VkTextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewCountText}" FontSize="11"
                                               Foreground="{StaticResource VkTextTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
