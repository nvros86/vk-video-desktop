<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="Transparent">

    <Grid Margin="24,16,24,80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Избранное" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button Content="Очистить" HorizontalAlignment="Right"
                    Style="{StaticResource TextButtonStyle}" Click="OnClearClick" />
        </Grid>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE721;" FontSize="48" Opacity="0.3" />
            <TextBlock Text="Ваш список избранного пуст" Opacity="0.5" TextAlignment="Center" />
            <TextBlock Text="Добавляйте видео в избранное, чтобы быстро находить их здесь."
                       Opacity="0.4" TextAlignment="Center" FontSize="12" />
        </StackPanel>

        <ItemsControl x:Name="FavoritesList" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VideoViewModel">
                    <Grid Margin="0,0,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" HorizontalAlignment="Stretch" Padding="0"
                                Click="OnVideoClick" Tag="{x:Bind Id}">
                            <Grid Width="280">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Height="158" CornerRadius="4,4,0,0">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                    <TextBlock Text="{x:Bind DurationText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Background="#CC000000"
                                               Foreground="White" FontSize="11" Padding="4,2"
                                               Margin="0,0,4,4" CornerRadius="2" />
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Author}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Content="Удалить"
                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                Style="{StaticResource TextButtonStyle}"
                                Click="OnRemoveClick" Tag="{x:Bind Id}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
