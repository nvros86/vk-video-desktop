<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource VkBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,80" Spacing="24" MaxWidth="600" HorizontalAlignment="Center">

            <TextBlock Text="Настройки" Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />

            <!-- General -->
            <StackPanel Spacing="16">
                <TextBlock Text="Общие" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource VkTextPrimaryBrush}" />

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Язык" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="LanguageCombo" SelectedIndex="0" Width="150"
                              SelectionChanged="OnSettingChanged_Combo">
                        <ComboBoxItem Content="Русский" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Тема" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="ThemeCombo" SelectedIndex="0" Width="150"
                              SelectionChanged="OnSettingChanged_Combo">
                        <ComboBoxItem Content="Тёмная" />
                        <ComboBoxItem Content="Светлая" />
                        <ComboBoxItem Content="Системная" />
                    </ComboBox>
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Запуск с Windows" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" x:Name="StartWithWindowsToggle" IsOn="False"
                                  Toggled="OnSettingChanged_Toggle" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Сворачивать в трей" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" x:Name="MinimizeToTrayToggle" IsOn="True"
                                  Toggled="OnSettingChanged_Toggle" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Уведомления" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" x:Name="NotificationsToggle" IsOn="True"
                                  Toggled="OnSettingChanged_Toggle" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Громкость по умолчанию" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="200"
                            ValueChanged="OnVolumeChanged" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Скорость воспроизведения" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="SpeedComboBox" Width="200" SelectionChanged="OnSpeedChanged">
                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                        <ComboBoxItem Content="0.75x" Tag="0.75" />
                        <ComboBoxItem Content="1x" Tag="1" />
                        <ComboBoxItem Content="1.25x" Tag="1.25" />
                        <ComboBoxItem Content="1.5x" Tag="1.5" />
                        <ComboBoxItem Content="2x" Tag="2" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{StaticResource VkSeparatorBrush}" />

            <!-- Video -->
            <StackPanel Spacing="16">
                <TextBlock Text="Видео" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource VkTextPrimaryBrush}" />

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Качество по умолчанию" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="QualityCombo" SelectedIndex="2" Width="150"
                              SelectionChanged="OnSettingChanged_Combo">
                        <ComboBoxItem Content="240p" />
                        <ComboBoxItem Content="360p" />
                        <ComboBoxItem Content="480p" />
                        <ComboBoxItem Content="720p" />
                        <ComboBoxItem Content="1080p" />
                        <ComboBoxItem Content="1440p" />
                        <ComboBoxItem Content="2160p" />
                    </ComboBox>
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Автовоспроизведение" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" x:Name="AutoplayToggle" IsOn="True"
                                  Toggled="OnSettingChanged_Toggle" />
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{StaticResource VkSeparatorBrush}" />

            <!-- Downloads -->
            <StackPanel Spacing="16">
                <TextBlock Text="Загрузки" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource VkTextPrimaryBrush}" />

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Папка загрузок" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DownloadFolderText" Text="C:\Users\Videos\VK Video"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource VkTextSecondaryBrush}" />
                        <Button Content="Изменить" Click="OnChangeFolderClick" />
                    </StackPanel>
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Макс. одновременных загрузок" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="MaxDownloadsCombo" SelectedIndex="1" Width="80"
                              SelectionChanged="OnSettingChanged_Combo">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" />
                    </ComboBox>
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ограничение скорости" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="SpeedLimitCombo" SelectedIndex="0" Width="150"
                              SelectionChanged="OnSettingChanged_Combo">
                        <ComboBoxItem Content="Без ограничений" />
                        <ComboBoxItem Content="512 КБ/с" />
                        <ComboBoxItem Content="1 МБ/с" />
                        <ComboBoxItem Content="2 МБ/с" />
                        <ComboBoxItem Content="5 МБ/с" />
                        <ComboBoxItem Content="10 МБ/с" />
                    </ComboBox>
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Количество повторных попыток" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <NumberBox Grid.Column="1" x:Name="RetryCountBox" Value="3" Minimum="0" Maximum="10" Width="80"
                               ValueChanged="OnRetryCountChanged" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Автовозобновление при запуске" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" x:Name="AutoResumeToggle" IsOn="True"
                                  Toggled="OnSettingChanged_Toggle" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Уведомления о загрузках" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" IsOn="True" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Удалять .part при отмене" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ToggleSwitch Grid.Column="1" x:Name="DeletePartToggle" IsOn="True"
                                  Toggled="OnSettingChanged_Toggle" />
                </Grid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Способ загрузки" VerticalAlignment="Center"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" x:Name="QualityBehaviorCombo" SelectedIndex="0" Width="250"
                              SelectionChanged="OnSettingChanged_Combo">
                        <ComboBoxItem Content="Показывать выбор качества" />
                        <ComboBoxItem Content="Использовать последнее качество" />
                        <ComboBoxItem Content="Использовать максимальное качество" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="Сетевые настройки" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"
                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                <CheckBox x:Name="UseProxyCheckBox" Content="Использовать прокси"
                          Checked="OnProxyChanged" Unchecked="OnProxyChanged" />
                <TextBox x:Name="ProxyAddressTextBox" Header="Адрес прокси" Width="300" Margin="0,8,0,0"
                         PlaceholderText="http://proxy:port" LostFocus="OnProxyAddressChanged" />
            </StackPanel>

            <Border Height="1" Background="{StaticResource VkSeparatorBrush}" />

            <!-- Cache -->
            <StackPanel Spacing="16">
                <TextBlock Text="Кэш" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource VkTextPrimaryBrush}" />

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Очистить кэш изображений"
                                   Foreground="{StaticResource VkTextPrimaryBrush}" />
                        <TextBlock Text="Миниатюры и аватары каналов"
                                   Foreground="{StaticResource VkTextTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Очистить" Click="OnClearCacheClick" />
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{StaticResource VkSeparatorBrush}" />

            <!-- About -->
            <StackPanel Spacing="8">
                <TextBlock Text="О приложении" Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                <TextBlock Text="VK Video Desktop v1.0.0-beta"
                           Foreground="{StaticResource VkTextSecondaryBrush}" />
                <TextBlock Text="Бета-версия • Production-ready Windows client for VK Video"
                           Foreground="{StaticResource VkTextTertiaryBrush}" FontSize="12" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
