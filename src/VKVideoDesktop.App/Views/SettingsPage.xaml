<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Settings Tabs -->
        <ListView x:Name="SettingsTabs" Grid.Column="0"
                  Background="{StaticResource VkSidebarBrush}"
                  SelectionChanged="OnSettingsTabChanged"
                  Padding="8,8,8,0">
            <ListViewItem Content="Основные" Tag="General" IsSelected="True" />
            <ListViewItem Content="Внешний вид" Tag="Appearance" />
            <ListViewItem Content="Воспроизведение" Tag="Playback" />
            <ListViewItem Content="Загрузки" Tag="Downloads" />
            <ListViewItem Content="Уведомления" Tag="Notifications" />
            <ListViewItem Content="Аккаунт" Tag="Account" />
            <ListViewItem Content="Конфиденциальность" Tag="Privacy" />
            <ListViewItem Content="О приложении" Tag="About" />
        </ListView>

        <!-- Settings Content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel Spacing="16" MaxWidth="600">

                <!-- General Settings -->
                <StackPanel x:Name="GeneralSettings" Spacing="12">
                    <TextBlock Text="Основные" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />

                    <!-- Language -->
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Язык" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Выберите язык интерфейса" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="Русский" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </Grid>

                    <!-- Theme -->
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Тема оформления" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Выберите тему интерфейса" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="Тёмная" />
                            <ComboBoxItem Content="Светлая" />
                            <ComboBoxItem Content="Системная" />
                        </ComboBox>
                    </Grid>

                    <!-- Startup -->
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Запуск при входе в Windows" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Автоматически запускать при старте системы" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="False" />
                    </Grid>

                    <!-- Minimize to tray -->
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Свернуть в трей" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="При закрытии сворачивать в системный трей" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="False" />
                    </Grid>

                    <!-- Default Volume -->
                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Громкость по умолчанию" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Начальная громкость воспроизведения" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Width="150" Minimum="0" Maximum="100"
                                Value="80"
                                Foreground="{StaticResource VkAccentBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Appearance Settings -->
                <StackPanel x:Name="AppearanceSettings" Visibility="Collapsed" Spacing="12">
                    <TextBlock Text="Внешний вид" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Качество превью на уменьшенном" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Качество изображений в уменьшенном режиме" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="1" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="480p" />
                            <ComboBoxItem Content="720p" />
                            <ComboBoxItem Content="1080p" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Язык интерфейса" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Выберите язык приложения" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="Русский" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Тема оформления" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Выберите тему приложения" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="Тёмная" />
                            <ComboBoxItem Content="Светлая" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Автоматическое обновление" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Проверять обновления при запуске" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" />
                    </Grid>
                </StackPanel>

                <!-- Playback Settings -->
                <StackPanel x:Name="PlaybackSettings" Visibility="Collapsed" Spacing="12">
                    <TextBlock Text="Воспроизведение" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Качество по умолчанию" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Стандартное качество видео" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="1" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="240p" />
                            <ComboBoxItem Content="360p" />
                            <ComboBoxItem Content="480p" />
                            <ComboBoxItem Content="720p" />
                            <ComboBoxItem Content="1080p" />
                            <ComboBoxItem Content="1440p" />
                            <ComboBoxItem Content="2160p" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Скорость воспроизведения" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Начальная скорость видео" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="2" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="0.5x" />
                            <ComboBoxItem Content="0.75x" />
                            <ComboBoxItem Content="1x" />
                            <ComboBoxItem Content="1.25x" />
                            <ComboBoxItem Content="1.5x" />
                            <ComboBoxItem Content="2x" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Автозамена" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Автоматически выбирать лучшее качество" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" />
                    </Grid>
                </StackPanel>

                <!-- Download Settings -->
                <StackPanel x:Name="DownloadSettings" Visibility="Collapsed" Spacing="12">
                    <TextBlock Text="Загрузки" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Папка загрузок" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Куда сохранять скачанные видео" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Изменить" Padding="12,6"
                                Background="{StaticResource VkCardBrush}"
                                Foreground="{StaticResource VkTextPrimaryBrush}"
                                BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Click="OnChangeDownloadFolderClick" />
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Макс. одновременных загрузок" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Количество параллельных загрузок" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="1" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Лимит скорости" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Ограничение скорости скачивания" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="150"
                                  Background="{StaticResource VkCardHoverBrush}"
                                  Foreground="{StaticResource VkTextPrimaryBrush}">
                            <ComboBoxItem Content="Без лимита" />
                            <ComboBoxItem Content="512 КБ/с" />
                            <ComboBoxItem Content="1 МБ/с" />
                            <ComboBoxItem Content="2 МБ/с" />
                            <ComboBoxItem Content="5 МБ/с" />
                            <ComboBoxItem Content="10 МБ/с" />
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Уведомления о загрузках" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Показывать уведомления о завершении" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" />
                    </Grid>

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Удалять .part файлы" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Удалять незавершённые загрузки при отмене" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" />
                    </Grid>
                </StackPanel>

                <!-- About Settings -->
                <StackPanel x:Name="AboutSettings" Visibility="Collapsed" Spacing="12">
                    <TextBlock Text="О приложении" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />

                    <Grid Style="{StaticResource SettingsCardStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="VK Video Desktop" FontWeight="SemiBold" FontSize="16"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="Бета-версия" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Обратная связь" Padding="16,8"
                            Background="{StaticResource VkCardBrush}"
                            Foreground="{StaticResource VkTextPrimaryBrush}"
                            BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                            CornerRadius="6" HorizontalAlignment="Left" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
