<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.ChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,80" Spacing="16">
            <Grid Height="200" CornerRadius="8" Background="{StaticResource VkCardBrush}">
                <Image x:Name="BannerImage" Stretch="UniformToFill" Opacity="0.6" />
            </Grid>

            <Grid Margin="0,-40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="80" Height="80" StrokeThickness="3"
                         Stroke="{StaticResource VkCardBrush}">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,8">
                    <TextBlock x:Name="ChannelNameText" Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                    <TextBlock x:Name="ChannelUsernameText" FontSize="13"
                               Foreground="{StaticResource VkTextSecondaryBrush}" />
                    <TextBlock x:Name="SubscriberCountText" FontSize="12"
                               Foreground="{StaticResource VkTextTertiaryBrush}" />
                </StackPanel>

                <Button Grid.Column="2" Content="Подписаться" VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <Expander Header="Описание">
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"
                           Foreground="{StaticResource VkTextSecondaryBrush}" />
            </Expander>

            <TextBlock Text="Видео" Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <ItemsControl x:Name="ChannelVideos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VideoViewModel">
                        <Button HorizontalAlignment="Left" Padding="0" Click="OnVideoClick" Tag="{x:Bind Id}">
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Смотреть" Click="OnContextPlay" Tag="{x:Bind Id}" />
                                    <MenuFlyoutItem Text="Добавить в избранное" Click="OnContextFavorite" Tag="{x:Bind Id}" />
                                    <MenuFlyoutItem Text="Скачать" Click="OnContextDownload" Tag="{x:Bind Id}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Открыть в VK" Click="OnContextOpenInVk" Tag="{x:Bind Id}" />
                                </MenuFlyout>
                            </Button.ContextFlyout>
                            <StackPanel Width="280">
                                <Grid Height="158" CornerRadius="4" Background="{StaticResource VkCardBrush}">
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                    <TextBlock Text="{x:Bind DurationText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Background="{StaticResource VkOverlayBrush}"
                                               Foreground="{StaticResource VkTextPrimaryBrush}" FontSize="11" Padding="4,2"
                                               Margin="0,0,4,4" CornerRadius="2" />
                                </Grid>
                                <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Author}" FontSize="12"
                                           Foreground="{StaticResource VkTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
