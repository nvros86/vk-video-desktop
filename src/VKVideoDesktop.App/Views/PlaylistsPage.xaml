<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid Margin="24,16,24,80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Плейлисты" Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <Button Content="＋ Создать" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}" Click="OnCreateClick" />
        </Grid>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8B4;" FontSize="48" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="У вас пока нет плейлистов"
                       Foreground="{StaticResource VkTextSecondaryBrush}" TextAlignment="Center" />
            <TextBlock Text="Создайте плейлист, чтобы группировать видео."
                       Foreground="{StaticResource VkTextTertiaryBrush}" TextAlignment="Center" FontSize="12" />
        </StackPanel>

        <ItemsControl x:Name="PlaylistsList" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistViewModel">
                    <Grid Margin="0,0,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" HorizontalAlignment="Left" Padding="0"
                                Click="OnPlaylistClick" Tag="{x:Bind Id}">
                            <StackPanel Width="200">
                                <Grid Height="112" CornerRadius="4,4,0,0" Background="{StaticResource VkCardBrush}">
                                    <TextBlock Text="&#xE8B4;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="36"
                                               Foreground="{StaticResource VkTextTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{StaticResource VkOverlayBrush}" CornerRadius="2"
                                            Margin="0,0,4,4" Padding="4,2">
                                        <TextBlock Text="{x:Bind VideoCountText}"
                                                   Foreground="{StaticResource VkTextPrimaryBrush}" FontSize="11" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Description}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontSize="12"
                                           Foreground="{StaticResource VkTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Content="Удалить"
                                HorizontalAlignment="Right" Margin="0,4,0,0"
                                Style="{StaticResource TextButtonStyle}"
                                Click="OnDeleteClick" Tag="{x:Bind Id}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
