<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="PlaylistsTitle" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource VkTextPrimaryBrush}" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="Создать плейлист" Padding="12,6"
                    Style="{StaticResource AccentButtonStyle}" CornerRadius="6"
                    Click="OnCreatePlaylistClick" />
        </Grid>

        <!-- Search -->
        <AutoSuggestBox Grid.Row="1" PlaceholderText="Поиск плейлистов..."
                        QueryIcon="Find" MaxWidth="400"
                        Margin="24,0"
                        Background="{StaticResource VkCardBrush}"
                        Foreground="{StaticResource VkTextPrimaryBrush}"
                        BorderBrush="{StaticResource VkCardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" />

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40">
            <FontIcon Glyph="&#xE8B4;" FontSize="64" Opacity="0.3" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="Нет плейлистов" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <TextBlock Text="Создайте плейлист для организации видео" Opacity="0.6" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextSecondaryBrush}" />
        </StackPanel>

        <!-- Playlists Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,80">
            <ItemsControl x:Name="PlaylistsItemsControl" Margin="24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistViewModel">
                        <Button HorizontalAlignment="Left" Margin="0,0,12,12"
                                Click="OnPlaylistItemClick" Tag="{x:Bind Id}"
                                Background="Transparent" BorderThickness="0" Padding="0">
                            <Grid Width="200">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Height="112" CornerRadius="8"
                                      Background="{StaticResource VkCardBrush}">
                                    <FontIcon Glyph="&#xE8B4;" FontSize="32"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{StaticResource VkTextTertiaryBrush}" />
                                    <Border Background="{StaticResource VkOverlayBrush}" CornerRadius="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,6,6" Padding="6,2">
                                        <TextBlock Text="{x:Bind VideoCountText}" Foreground="White" FontSize="11" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                               Foreground="{StaticResource VkTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" FontSize="12"
                                               Foreground="{StaticResource VkTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
