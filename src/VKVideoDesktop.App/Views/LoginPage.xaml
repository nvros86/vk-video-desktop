<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
        <StackPanel Spacing="24" Margin="24">
            <TextBlock Text="Вход в VK Video" Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Для использования приложения необходима авторизация через VK."
                       TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.7" />

            <Button Content="Войти через VK" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" Click="OnLoginClick"
                    Padding="32,12" />

            <TextBlock x:Name="ErrorText" Text="" Foreground="Red"
                       HorizontalAlignment="Center" Visibility="Collapsed" />

            <TextBlock Text="После нажатия 'Войти' откроется браузер. Скопируйте токен из адресной строки после '#'."
                       TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.5" FontSize="12" />
        </StackPanel>
    </Grid>
</Page>
