<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid>
        <!-- Intro State -->
        <StackPanel x:Name="IntroState" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="480" Spacing="20" Padding="32">
            <!-- VK Logo -->
            <Grid Width="80" Height="80" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource VkAccentGlowBrush}" />
                <FontIcon Glyph="&#xE72B;" FontSize="36" Foreground="{StaticResource VkAccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Uid="LoginTitle" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource VkTextPrimaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" />

            <TextBlock x:Uid="LoginDesc" FontSize="14" TextWrapping="Wrap"
                       Foreground="{StaticResource VkTextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" />

            <Button x:Name="LoginButton" x:Uid="LoginButton" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" Click="OnLoginClick"
                    Padding="40,14" CornerRadius="24" FontSize="15" Margin="0,8,0,0" />

            <!-- WebView2 not available fallback -->
            <Button x:Name="OpenInBrowserButton" Content="&#xE774; Открыть в браузере"
                    HorizontalAlignment="Center"
                    Background="Transparent" Foreground="{StaticResource VkTextSecondaryBrush}"
                    BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="20,10" FontSize="13" Margin="0,4,0,0"
                    Click="OnOpenInBrowserClick" Visibility="Collapsed" />

            <TextBlock x:Uid="LoginStep2" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource VkTextTertiaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Visibility="Collapsed" x:Name="Step2Text" />
        </StackPanel>

        <!-- WebView2 OAuth State -->
        <Grid x:Name="WebViewState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Padding="16,10" Background="{StaticResource VkSurfaceBrush}"
                  BorderBrush="{StaticResource VkTopBarBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="BackToIntroButton" Content="&#xE72B;"
                            FontFamily="Segoe MDL2 Assets" Style="{StaticResource TextButtonStyle}"
                            Click="OnBackToIntroClick" />
                    <TextBlock Text="VK Video Desktop" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource VkTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Uid="LoginWebViewTitle" FontSize="13"
                           Foreground="{StaticResource VkTextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button Grid.Column="2" Content="&#xE774;" FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource TextButtonStyle}" Click="OnOpenInBrowserClick"
                        ToolTipService.ToolTip="Открыть в браузере" />
            </Grid>

            <WebView2 x:Name="LoginWebView" Grid.Row="1" />

            <!-- WebView2 loading overlay -->
            <StackPanel x:Name="WebViewLoadingOverlay" Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource VkBackgroundBrush}" Spacing="12"
                        Padding="40,30" CornerRadius="12"
                        BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1">
                <ProgressRing IsActive="True" Width="36" Height="36"
                              Foreground="{StaticResource VkAccentBrush}" />
                <TextBlock Text="Загрузка страницы авторизации..." FontSize="13"
                           Foreground="{StaticResource VkTextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <StackPanel x:Name="LoadingState" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <ProgressRing IsActive="True" Width="48" Height="48"
                          Foreground="{StaticResource VkAccentBrush}" />
            <TextBlock x:Uid="LoginChecking" FontSize="14"
                       Foreground="{StaticResource VkTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Success State -->
        <StackPanel x:Name="SuccessState" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Grid Width="80" Height="80" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource VkSuccessBrush}" Opacity="0.15" />
                <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{StaticResource VkSuccessBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Uid="LoginSuccess" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource VkTextPrimaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error State -->
        <StackPanel x:Name="ErrorState" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                    MaxWidth="400" Padding="32">
            <Grid Width="80" Height="80" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource VkErrorBrush}" Opacity="0.15" />
                <FontIcon Glyph="&#xEA39;" FontSize="40" Foreground="{StaticResource VkErrorBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Uid="LoginErrorTitle" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource VkTextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorDetailText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource VkTextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button x:Uid="LoginRetryButton"
                        Style="{StaticResource AccentButtonStyle}" Click="OnLoginClick"
                        Padding="32,10" CornerRadius="20" />
                <Button Content="Назад" Click="OnBackToIntroClick"
                        Background="{StaticResource VkCardBrush}"
                        Foreground="{StaticResource VkTextPrimaryBrush}"
                        BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="32,10" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
