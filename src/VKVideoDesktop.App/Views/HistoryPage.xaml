<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid Margin="24,16,24,80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="История просмотров" Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <Button Content="Очистить" HorizontalAlignment="Right"
                    Style="{StaticResource TextButtonStyle}" Click="OnClearClick" />
        </Grid>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="История просмотров пуста"
                       Foreground="{StaticResource VkTextSecondaryBrush}" TextAlignment="Center" />
            <TextBlock Text="Начните смотреть видео, и они появятся здесь."
                       Foreground="{StaticResource VkTextTertiaryBrush}" TextAlignment="Center" FontSize="12" />
        </StackPanel>

        <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                    <Grid Height="80" Margin="0,0,0,4" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="140" Height="80" CornerRadius="4"
                              Margin="0,0,12,0">
                            <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{StaticResource VkOverlayBrush}" CornerRadius="2"
                                        Margin="0,0,3,3" Padding="3,1">
                                <TextBlock Text="{x:Bind DurationText}"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" FontSize="10" />
                            </Border>
                            <ProgressBar Value="{x:Bind Progress}" Maximum="100"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Width="140" Height="3"
                                         Foreground="{StaticResource VkProgressBrush}"
                                         Background="Transparent" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                       Foreground="{StaticResource VkTextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Author}" FontSize="12"
                                       Foreground="{StaticResource VkTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind LastPositionText}" FontSize="11"
                                       Foreground="{StaticResource VkTextTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                            <Button Content="▶ Смотреть" Click="OnPlayClick"
                                    Tag="{x:Bind VideoId}" />
                            <Button Content="Удалить" Click="OnRemoveClick"
                                    Tag="{x:Bind VideoId}" Style="{StaticResource TextButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
