<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VKVideoDesktop.App.Views"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="HistoryTitle" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource VkTextPrimaryBrush}" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="Очистить историю" Padding="12,6"
                    Background="{StaticResource VkCardBrush}"
                    Foreground="{StaticResource VkTextSecondaryBrush}"
                    BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Click="OnClearHistoryClick" />
        </Grid>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="24,0">
            <RadioButton x:Uid="HistoryTabAll" IsChecked="True" Style="{StaticResource FilterPillStyle}" />
            <RadioButton x:Uid="HistoryTabVideos" Style="{StaticResource FilterPillStyle}" />
            <RadioButton x:Uid="HistoryTabChannels" Style="{StaticResource FilterPillStyle}" />
        </StackPanel>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,40">
            <FontIcon Glyph="&#xE81C;" FontSize="64" Opacity="0.3" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="История пуста" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <TextBlock Text="Здесь будут отображаться просмотренные видео" Opacity="0.6" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextSecondaryBrush}" />
        </StackPanel>

        <!-- History List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,80">
            <ListView x:Name="HistoryListView" SelectionMode="None"
                      Background="Transparent" BorderThickness="0"
                      Padding="24,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                        <Grid Height="80" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Border Grid.Column="0" Width="140" Height="80" CornerRadius="6"
                                    Margin="0,0,12,0">
                                <Grid>
                                    <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                    <Border Background="{StaticResource VkOverlayBrush}" CornerRadius="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,4,4" Padding="4,2">
                                        <TextBlock Text="{x:Bind DurationText}" Foreground="White" FontSize="10" />
                                    </Border>
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="100"
                                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                 Width="140" Height="3" Background="Transparent"
                                                 Foreground="{StaticResource VkAccentBrush}" />
                                </Grid>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                           Foreground="{StaticResource VkTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Author}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" FontSize="12"
                                           Foreground="{StaticResource VkTextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind LastPositionText}" FontSize="11"
                                           Foreground="{StaticResource VkTextTertiaryBrush}" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Content="Смотреть" Padding="12,6"
                                        Style="{StaticResource AccentButtonStyle}" CornerRadius="6"
                                        Click="OnPlayClick" Tag="{x:Bind VideoId}" />
                                <Button Padding="8,6"
                                        Background="{StaticResource VkCardBrush}"
                                        Foreground="{StaticResource VkTextSecondaryBrush}"
                                        BorderBrush="{StaticResource VkCardBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Click="OnRemoveClick" Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
