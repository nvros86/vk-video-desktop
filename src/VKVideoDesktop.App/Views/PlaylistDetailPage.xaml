<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VKVideoDesktop.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VKVideoDesktop.App.ViewModels"
    Background="{StaticResource VkBackgroundBrush}">

    <Grid Margin="24,16,24,80">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <Button Content="&#xE72B;" Style="{StaticResource TextButtonStyle}"
                        Click="OnBackClick" VerticalAlignment="Center" />
                <TextBlock x:Name="PlaylistTitle" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource VkTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Content="Смотреть все" Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}" CornerRadius="8" />
        </Grid>

        <!-- Video Count -->
        <TextBlock x:Name="VideoCountLabel" Grid.Row="1" FontSize="13"
                   Foreground="{StaticResource VkTextSecondaryBrush}" Margin="0,0,0,16" />

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8B4;" FontSize="64" Opacity="0.3" Foreground="{StaticResource VkTextTertiaryBrush}" />
            <TextBlock Text="Плейлист пуст" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextPrimaryBrush}" />
            <TextBlock Text="Добавьте видео в плейлист" Opacity="0.6" HorizontalAlignment="Center"
                       Foreground="{StaticResource VkTextSecondaryBrush}" />
        </StackPanel>

        <!-- Videos Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VideosList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VideoViewModel">
                        <Grid Margin="0,0,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" HorizontalAlignment="Left" Padding="0"
                                    Click="OnVideoClick" Tag="{x:Bind Id}"
                                    Background="Transparent" BorderThickness="0">
                                <Grid Width="240">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Height="135" CornerRadius="8">
                                        <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{StaticResource VkOverlayBrush}" CornerRadius="4"
                                                Margin="0,0,6,6" Padding="6,2">
                                            <TextBlock Text="{x:Bind DurationText}"
                                                       Foreground="White" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                   Foreground="{StaticResource VkTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Author}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" FontSize="12"
                                                   Foreground="{StaticResource VkTextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Row="1" Content="Удалить" HorizontalAlignment="Right" Margin="0,4,0,0"
                                    Background="Transparent" BorderThickness="0" Padding="8,4"
                                    Foreground="{StaticResource VkErrorBrush}" FontSize="12"
                                    Click="OnRemoveClick" Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
