<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VKVideoDesktopSetup</AssemblyName>
    <RootNamespace>VKVideoDesktop.Setup</RootNamespace>
    <Version>1.0.0-beta</Version>
    <AssemblyTitle>VK Video Desktop Installer</AssemblyTitle>
    <Description>Installer for VK Video Desktop v1.0.0-beta</Description>
    <NoWarn>CS1591;NU1603;NU1605</NoWarn>
    <ApplicationIcon>..\VKVideoDesktop.App\Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\VKVideoDesktop.App\Assets\icon.ico" Link="icon.ico" />
    <EmbeddedResource Include="..\..\VKVideoDesktop-win-x64.zip" Link="app.zip" />
    <EmbeddedResource Include="uninstall\Uninstall.exe" Link="uninstall.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
