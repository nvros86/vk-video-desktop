<Window x:Class="VKVideoDesktop.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VK Video Desktop — Установка" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D3F" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VK Video Desktop" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Мастер установки" FontSize="14" Foreground="#AAAACC" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="30,20">
            <StackPanel x:Name="WelcomePage" Visibility="Visible" VerticalAlignment="Center">
                <TextBlock Text="Добро пожаловать!" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <TextBlock Text="Этот мастер поможет установить VK Video Desktop на ваш компьютер." TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="14"/>

                <Border x:Name="UpdateInfoBorder" Visibility="Collapsed" Background="#1B3A20" CornerRadius="4" Padding="12" Margin="0,15,0,0" BorderBrush="#4CAF50" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UpdateVersionText" FontSize="13" Foreground="#4CAF50"/>
                        <Button x:Name="DownloadUpdateButton" Content="Скачать обновление" Click="OnDownloadUpdateClick"
                                Margin="0,8,0,0" Padding="15,6" Background="#6C63FF" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="UninstallButton" Content="Удалить VK Video Desktop" Click="OnUninstallClick"
                        Visibility="Collapsed" Margin="0,20,0,0" Padding="15,8" Background="#FF5252" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="Нажмите «Далее» для продолжения." Margin="0,20,0,0" Foreground="#999999"/>
            </StackPanel>

            <StackPanel x:Name="LicensePage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Лицензионное соглашение" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border BorderBrush="#444466" BorderThickness="1" Padding="10" MaxHeight="200">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#CCCCCC">MIT License</TextBlock>
                    </ScrollViewer>
                </Border>
                <CheckBox x:Name="AcceptLicenseCheck" Content="Я принимаю условия лицензионного соглашения" Margin="0,10,0,0" Foreground="#CCCCCC"/>
            </StackPanel>

            <StackPanel x:Name="LocationPage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Папка установки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <TextBlock Text="Выберите папку для установки VK Video Desktop:" Foreground="#CCCCCC" Margin="0,0,0,10"/>
                <Border BorderBrush="#444466" BorderThickness="1" CornerRadius="4" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathBox" Grid.Column="0" FontSize="14" Padding="8"
                                 BorderThickness="0" Background="Transparent" Foreground="White"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Обзор..." Click="OnBrowseClick"
                                Padding="15,8" Margin="5,0,0,0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="SpaceInfo" Margin="0,10,0,0" Foreground="#888888" FontSize="12"/>
                <CheckBox x:Name="CreateDesktopShortcut" Content="Создать ярлык на рабочем столе" IsChecked="True" Margin="0,15,0,0" Foreground="#CCCCCC"/>
                <CheckBox x:Name="StartWithWindows" Content="Запускать с Windows" IsChecked="False" Margin="0,8,0,0" Foreground="#CCCCCC"/>
            </StackPanel>

            <StackPanel x:Name="InstallingPage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Установка..." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <ProgressBar x:Name="InstallProgress" Height="20" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="InstallStatus" Margin="0,10,0,0" Foreground="#CCCCCC"/>
            </StackPanel>

            <StackPanel x:Name="CompletePage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Установка завершена!" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,15"/>
                <TextBlock Text="VK Video Desktop успешно установлен." Foreground="#CCCCCC" FontSize="14"/>
                <TextBlock x:Name="InstallPathInfo" Margin="0,10,0,0" Foreground="#888888" FontSize="12"/>
                <CheckBox x:Name="LaunchAfterInstall" Content="Запустить VK Video Desktop" IsChecked="True" Margin="0,15,0,0" Foreground="#CCCCCC"/>
            </StackPanel>

            <StackPanel x:Name="UninstallPage" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="UninstallTitle" Text="Удаление..." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <ProgressBar x:Name="UninstallProgress" Height="20" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="UninstallStatus" Margin="0,10,0,0" Foreground="#CCCCCC"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#2D2D3F" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Назад" Click="OnBackClick" Margin="0,0,10,0"
                        Background="#3D3D5F" Foreground="White" BorderThickness="0" Padding="20,8"/>
                <Button x:Name="NextButton" Content="Далее" Click="OnNextClick"
                        Background="#6C63FF" Foreground="White" BorderThickness="0" Padding="20,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
